-- Struktur Tabel `matches`
CREATE TABLE IF NOT EXISTS `matches` (
  `id` INT(11) NOT NULL AUTO_INCREMENT,
  `match_code` VARCHAR(10) NOT NULL,
  `hari` VARCHAR(50) NOT NULL,
  `jam` VARCHAR(30) NOT NULL,
  `fase` VARCHAR(50) NOT NULL,
  `team_a` VARCHAR(10) NOT NULL,
  `team_b` VARCHAR(10) NOT NULL,
  `score_a` INT(11) DEFAULT 0,
  `score_b` INT(11) DEFAULT 0,
  `status` ENUM('Belum Dimulai','Berlangsung','Selesai') DEFAULT 'Belum Dimulai',
  PRIMARY KEY (`id`)
) ENGINE=MyISAM DEFAULT CHARSET=latin1;

